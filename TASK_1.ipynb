        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "df = pd.read_csv(\"/content/student_data.csv\")\n",
        "df.head()\n",
        "df = df.dropna()\n",
        "df = df.drop_duplicates()\n",
        "df.hist(figsize=(10,8))\n",
        "plt.show()\n",
        "df.to_csv(\"cleaned_data.csv\", index=False)\n"
